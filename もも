<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>ニッポン鉄道すごろく</title>
<style>
:root{--k:#1b2a49}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;background:#101a30;color:var(--k);font:700 15px/1.4 "Hiragino Sans","Noto Sans JP","Yu Gothic",Meiryo,sans-serif;touch-action:manipulation;overscroll-behavior:none;user-select:none;-webkit-user-select:none}
#app{position:relative;height:100vh;height:100dvh;max-width:520px;margin:auto;background:#eef5f7;overflow:hidden}
.s{display:none;position:absolute;inset:0;flex-direction:column;gap:10px;padding:max(12px,env(safe-area-inset-top)) 12px max(12px,env(safe-area-inset-bottom));overflow:auto}
.s.on{display:flex}
h1{font:900 42px/1.1 sans-serif;margin:18px 0 0;letter-spacing:.03em}
h2{margin:8px 0 0;font-size:26px}
p{margin:0}
.pl{display:flex;flex-direction:column;gap:10px;background:#fff;border:2px solid var(--k);border-radius:8px;padding:12px;box-shadow:0 3px 0 var(--k)}
button{font:inherit;font-weight:900;color:var(--k);background:#fff;border:2px solid var(--k);border-radius:10px;min-height:48px;padding:0 12px;box-shadow:0 3px 0 var(--k)}
button:active{transform:translateY(3px);box-shadow:none}
button:disabled{opacity:.45}
button.p{background:#1f63c6;color:#fff}
button.g{background:#2f9e5f;color:#fff}
button.big{min-height:58px;font-size:18px}
input{font:inherit;font-size:18px;border:2px solid var(--k);border-radius:8px;padding:10px;width:100%;user-select:text;-webkit-user-select:text}
small{font-weight:500;font-size:12px;color:#4a5670}
#er{color:#e2492f}
#code{font:900 58px/1 sans-serif;letter-spacing:.1em}
.r{display:flex;align-items:center;gap:6px}
.gr{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.bg{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:50%;color:#fff;font-size:12px;border:2px solid #fff;box-shadow:0 0 0 1.5px var(--k);flex:none;margin-right:4px}
#sg{gap:6px;padding-left:8px;padding-right:8px}
#hd{display:flex;justify-content:space-between;align-items:baseline;font-size:18px}
#db{background:#fff;border:2px solid var(--k);border-bottom:5px solid #e2492f;border-radius:6px;padding:4px 10px;font-size:14px}
#db b{font:900 22px sans-serif}
#ps{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:4px}
.pc{background:#fff;border:2px solid #c3cdda;border-radius:6px;padding:4px 6px;font-size:12px;line-height:1.3;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pc.cur{border-color:var(--k);box-shadow:0 3px 0 var(--k)}
.pc small{display:block}
#mw{flex:1 0 230px;position:relative;border:2px solid var(--k);border-radius:8px;overflow:hidden;background:#cfe6ee}
#cv{position:absolute;inset:0;width:100%;height:100%;display:block}
#toast{position:absolute;left:50%;top:38%;transform:translate(-50%,-50%);max-width:92%;background:#fff;border:2px solid var(--k);border-radius:8px;box-shadow:0 4px 0 var(--k);padding:10px 14px;font-size:17px;font-weight:900;text-align:center;white-space:pre-line;opacity:0;pointer-events:none;transition:opacity .15s}
#toast.on{opacity:1}
#msg{min-height:42px}
#ac,#hand{display:flex;flex-wrap:wrap;gap:8px}
#ac>*{flex:1 1 40%}
#ac>.w{flex:1 1 100%}
#hand button{flex:1;min-height:42px;font-size:13px}
#hand small{display:block}
</style>
</head>
<body>
<div id="app">
 <div class="s on" id="st">
  <h1>ニッポン<br>鉄道すごろく</h1>
  <p>目的地をめざして日本を一周！<br>友だちと2〜4人で通信対戦できます。</p>
  <div class="pl">
   <input id="nm" maxlength="6" placeholder="なまえ（6文字まで）" autocomplete="off">
   <button class="p" data-a="host">ルームを作る（ホスト）</button>
   <input id="cd" inputmode="numeric" maxlength="4" placeholder="ルームID（4けた）" autocomplete="off">
   <button data-a="join">ルームIDで参加する</button>
   <div id="er"></div>
  </div>
 </div>
 <div class="s" id="sl">
  <div class="pl"><div>ルームID</div><div id="code"></div><small>友だちにこの4けたを伝えて、同じページから参加してもらおう。</small></div>
  <div class="pl" id="ml"></div>
  <div class="pl"><div>ゲームの長さ</div><div class="gr" id="len"></div></div>
  <small>青＝お金が増える／赤＝減る／黄＝カード／緑＝物件（決算で収益）。目的地に一番乗りで援助金！ 目的地から一番遠い人に貧乏神がとりつき、他の人とすれ違う・同じ駅に止まるとなすりつけられます。最後に総資産（所持金＋物件）が一番多い人が優勝。</small>
  <div class="gr" id="hb"><button data-a="cpu">CPUを追加</button><button class="p" data-a="start">ゲーム開始</button></div>
  <p id="gw">ホストの開始を待っています…</p>
 </div>
 <div class="s" id="sg">
  <div id="hd"></div><div id="db"></div><div id="ps"></div>
  <div id="mw"><canvas id="cv"></canvas><div id="toast"></div></div>
  <div id="msg"></div><div id="ac"></div><div id="hand"></div>
 </div>
 <div class="s" id="se">
  <h2>けっか発表</h2><div id="rk"></div>
  <button class="p" data-a="again">もう一度あそぶ</button>
  <button data-a="quit">タイトルへ戻る</button>
 </div>
</div>

<script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js" onerror="document.head.append(Object.assign(document.createElement('script'),{src:'https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js'}))"></script>
<script>
'use strict';
const $=s=>document.querySelector(s),
 esc=s=>String(s).replace(/[&<>"']/g,c=>'&#'+c.charCodeAt(0)+';'),
 R=n=>Math.floor(Math.random()*n),
 sl=ms=>new Promise(r=>setTimeout(r,ms)),
 sh=a=>a.map(x=>[Math.random(),x]).sort((a,b)=>a[0]-b[0]).map(x=>x[1]);
const PFX='nsugo-',PO={debug:1},COL=['#f08a24','#e84d8a','#7a4ddb','#17a2b8'];
// 駅の種類: p=プラス(青) m=マイナス(赤) c=カード(黄) h=物件(緑) → [色,記号]
const TY={p:['#2a6fdb','＋'],m:['#e2492f','−'],c:['#f4b400','★'],h:['#2f9e5f','家']};
const CD={k:['急行カード','🚄','サイコロ2個'],w:['ぶっとびカード','🌀','ランダムな駅へ'],b:['ブレーキカード','🛑','相手を1マスに'],s:['スリカード','🧤','相手から奪う']};
// [駅名,x,y,種類,ラベル位置,物件名,価格(万円),年利回り(%)]
const ST=[
['東京',300,222,'h','r','寿司店',1800,12],['横浜',288,262,'p','r'],['静岡',256,288,'h','b','茶畑',700,22],
['名古屋',214,302,'c','b'],['大阪',180,326,'h','b','たこ焼き店',900,25],['神戸',146,344,'m','b'],
['岡山',108,352,'h','t','きびだんご店',600,24],['広島',66,364,'p','t'],['下関',34,338,'h','t','ふぐ料理店',1000,18],
['松江',80,310,'m','t'],['京都',150,282,'h','t','老舗旅館',2200,10],['金沢',208,252,'p','l'],
['新潟',246,206,'m','l'],['青森',240,128,'h','l','りんご園',600,24],['仙台',300,176,'c','r'],
['函館',268,80,'p','l'],['札幌',300,38,'h','r','ラーメン店',1500,15],['高松',178,396,'h','r','うどん店',500,26],
['高知',146,440,'c','b'],['松山',126,402,'p','t'],['大分',86,424,'h','r','温泉宿',1300,15],
['鹿児島',62,474,'m','b'],['熊本',30,430,'p','b'],['福岡',30,384,'c','r']];
// 各駅から進める駅（分岐: 名古屋→大阪/金沢、岡山→広島/高松、青森→仙台/函館）
const NX=[[1],[2],[3],[4,11],[5],[6],[7,17],[8],[9],[10],[11],[12],[13],[14,15],[0],[16],[14],[18],[19],[20],[21],[22],[23],[8]];
// 駅間の最短マス数
const D=ST.map((_,s)=>{const d=Array(ST.length).fill(99);d[s]=0;const q=[s];for(const u of q)for(const v of NX[u])if(d[v]>d[u]+1){d[v]=d[u]+1;q.push(v)}return d});

let G,me=0,host=0,peer,conns=[],hc,pend,seq=0,room='',myName='',pk=-1,seen=0;
const fm=v=>{const a=Math.abs(v),o=Math.floor(a/1e4),m=a%1e4;return(v<0?'−':'')+(o?o+'億':'')+(m||!o?m.toLocaleString()+'万':'')};
const yr=()=>Math.ceil(G.turn/12),mu=()=>1+.3*(yr()-1),amt=(a,b)=>Math.round((a+R(b)*100)*mu()/10)*10;

/* ============ ホスト側ゲーム進行 ============ */
const bc=()=>{conns.forEach(c=>c&&c.open&&c.send({m:'S',s:G}));render()};
const say=t=>{G.msg=t};
const ev=async(t,ms=1200)=>{G.ev={id:++seq,t};say(t);bc();await sl(ms)};
const wait=(i,ty,x)=>new Promise(res=>{pend={i,ty,res,x};const p=G.players[i];
 if(p.cpu||p.off)setTimeout(()=>{if(pend&&pend.res===res){pend=null;res(auto(i,ty,x))}},800)});
const okCard=(i,a)=>{const c=G.players[i].cards[a.ci];return c&&!G.used&&(!'bs'.includes(c)||(a.tg!==i&&!!G.players[a.tg]))};
function act(i,a){const q=pend;if(!q||q.i!==i||!q.ty.includes(a.a))return;
 if(a.a==='card'&&!okCard(i,a))return;if(a.a==='dir'&&!q.x.includes(a.n))return;pend=null;q.res(a)}
function auto(i,ty,x){const p=G.players[i];
 if(ty.includes('dir'))return{a:'dir',n:Math.random()<.7?x.reduce((a,b)=>D[b][G.dest]<D[a][G.dest]?b:a):x[R(x.length)]};
 if(ty.includes('buy'))return{a:'buy',y:1};
 if(ty.includes('card')&&p.cards.length&&Math.random()<.5){const o=G.players.map((_,j)=>j).filter(j=>j!==i);return{a:'card',ci:R(p.cards.length),tg:o[R(o.length)]}}
 return{a:'roll'}}

async function newDest(){const old=G.dest;let t;
 do t=R(ST.length);while(t===old||G.players.some(p=>p.node===t));
 G.dest=t;const d=G.players.map(p=>D[p.node][t]),m=Math.max(...d),c=d.map((v,j)=>v===m?j:-1).filter(j=>j>=0),f=c[R(c.length)];
 G.players.forEach((p,j)=>p.god=j===f?1:0);
 await ev('🎯 次の目的地は'+ST[t][0]+'！\n👹 貧乏神は'+G.players[f].name+'にとりついた',1800)}
async function goal(i){const p=G.players[i],b=Math.round(1500*mu()/10)*10;p.cash+=b;p.goal++;
 await ev('🎉 '+p.name+'が'+ST[G.dest][0]+'に一番乗り！\n援助金 '+fm(b),1700);await newDest()}
// すれ違い・同じ駅で貧乏神をなすりつけ／目的地到着チェック
async function touch(i){const p=G.players[i];
 if(p.god){const q=G.players.findIndex((o,j)=>j!==i&&o.node===p.node);
  if(q>=0){p.god=0;G.players[q].god=1;await ev('👹 貧乏神が'+G.players[q].name+'にうつった！',1400)}}
 if(p.node===G.dest){await goal(i);return 1}return 0}
async function land(i){const p=G.players[i],s=ST[p.node],k=s[3];G.sub='ld';
 if(k==='p'){const a=amt(200,5);p.cash+=a;await ev('💰 '+s[0]+'駅で '+fm(a)+' ゲット！')}
 else if(k==='m'){const a=amt(100,4);p.cash-=a;await ev('💸 '+s[0]+'駅で '+fm(a)+' の出費…')}
 else if(k==='c'){if(p.cards.length>=3)await ev('🃏 カードがいっぱいで取れなかった');
  else{const c='kkwbs'[R(5)];p.cards.push(c);await ev('🃏 '+CD[c][0]+'を手に入れた！')}}
 else{const o=G.own[p.node];
  if(o<0){if(p.cash>=s[6]){G.sub='buy';G.bn=p.node;say(s[0]+'の'+s[5]+'を買いますか？');bc();
    const a=await wait(i,['buy']);G.sub='ld';
    if(a.y){p.cash-=s[6];G.own[p.node]=i;await ev('🏠 '+s[5]+'を '+fm(s[6])+' で購入！')}}
   else await ev('💦 '+s[5]+'を買うお金が足りない…',900)}
  else await ev(o===i?'自分の物件（'+s[5]+'）':G.players[o].name+'の物件（'+s[5]+'）',800)}}
async function move(i){const p=G.players[i],br=p.brake;let v=[];
 for(let k=0;k<G.dn;k++)v.push(1+R(6));let n=v.reduce((a,b)=>a+b);
 if(br){p.brake=0;v=[1];n=1}
 G.sub='mv';G.left=n;await ev('🎲 '+(v.length>1?v.join('+')+'＝':'')+n+'マス進む！'+(br?'（ブレーキ）':''),1300);
 for(;n>0;n--){const o=NX[p.node];let t=o[0];
  if(o.length>1){G.sub='dir';G.opts=o;G.left=n;say('どっちへ進む？（あと'+n+'マス）');bc();
   t=(await wait(i,['dir'],o)).n;G.opts=[];G.sub='mv'}
  p.node=t;G.left=n-1;say(p.name+'：あと'+(n-1)+'マス');bc();await sl(350);
  if(await touch(i))break}
 await land(i)}
// ターン終了時の貧乏神の悪さ
async function endTurn(i){const p=G.players[i];if(!p.god)return;
 const r=Math.random(),own=ST.map((_,k)=>k).filter(k=>G.own[k]===i);
 if(r<.15&&own.length){const k=own[R(own.length)],v=Math.floor(ST[k][6]*.8);G.own[k]=-1;p.cash+=v;
  await ev('👹 貧乏神が'+ST[k][5]+'を売り払った！\n'+fm(v)+'だけ戻った',1600)}
 else if(r<.35&&p.cards.length){p.cards.pop();await ev('👹 貧乏神がカードを食べた！')}
 else{const a=amt(200,4);p.cash-=a;await ev('👹 貧乏神が '+fm(a)+' を持っていった…')}}
async function turn(i){const p=G.players[i];G.cur=i;G.used=0;G.dn=1;G.opts=[];say(p.name+'のばん');
 for(;;){G.sub='start';bc();const a=await wait(i,G.used?['roll']:['roll','card']);G.sub='busy';
  if(a.a==='roll')break;
  G.used=1;const c=p.cards.splice(a.ci,1)[0],q=G.players[a.tg];
  if(c==='k'){G.dn=2;await ev('🚄 急行カード！サイコロ2個')}
  else if(c==='b'){q.brake=1;await ev('🛑 '+q.name+'は次のターン1マスしか進めない！')}
  else if(c==='s'){const m=Math.max(0,Math.min(500,q.cash));q.cash-=m;p.cash+=m;await ev('🧤 '+q.name+'から '+fm(m)+' 奪った！')}
  else{await ev('🌀 ぶっとびカード！',800);let t;do t=R(ST.length);while(t===p.node);
   p.node=t;bc();await sl(500);await touch(i);await land(i);await endTurn(i);return}}
 await move(i);await endTurn(i)}
async function settle(f){const r=G.players.map((p,i)=>{let s=0;
  ST.forEach((x,k)=>{if(G.own[k]===i)s+=Math.floor(x[6]*x[7]/100)});p.cash+=s;return p.name+'　+'+fm(s)});
 await ev('📊 '+(f?'最終':yr()+'年目')+'決算\n'+r.join('\n'),3500)}
async function run(){G.order=sh(G.players.map((_,i)=>i));await newDest();
 for(;;){for(const i of G.order)await turn(i);
  if(G.turn>=G.tt){await settle(1);break}
  if(G.turn%12===0)await settle(0);G.turn++}
 G.rank=G.players.map((p,i)=>{const v=ST.reduce((s,x,k)=>s+(G.own[k]===i?x[6]:0),0);return{i,c:p.cash,v,t:p.cash+v}}).sort((a,b)=>b.t-a.t);
 G.phase='end';bc()}
function start(){pend=null;
 Object.assign(G,{phase:'play',own:ST.map(()=>-1),cur:0,sub:'',opts:[],left:0,dn:1,used:0,msg:'',ev:null,rank:null,turn:1,dest:-1});
 G.players.forEach(p=>Object.assign(p,{node:0,cash:3000,cards:[],god:0,brake:0,goal:0}));
 run().catch(e=>{console.error(e);alert('エラー: '+e.message)})}
function again(){const keep=G.players.map((p,i)=>i===0||p.cpu||!p.off);
 const ps=G.players.filter((_,i)=>keep[i]).map(p=>({name:p.name,cpu:p.cpu}));
 conns=conns.filter((_,i)=>keep[i]);G={phase:'lobby',room,tt:G.tt,players:ps};
 conns.forEach((c,j)=>c&&c.send({m:'you',i:j}));bc()}

/* ============ 通信 (PeerJS) ============ */
const peerLib=()=>new Promise((ok,ng)=>{let n=0;(function f(){window.Peer?ok():++n>40?ng(Error('lib')):setTimeout(f,150)})()});
const open=id=>new Promise((ok,ng)=>{const p=id?new Peer(id,PO):new Peer(PO);let o=0;
 p.on('open',()=>{o=1;ok(p)});p.on('error',e=>{if(!o){p.destroy();ng(e)}})});
const uniq=n=>{n=[...String(n||'プレイヤー')].slice(0,6).join('');let m=n,k=2;while(G.players.some(p=>p.name===m))m=n+k++;return m};
async function mkRoom(){await peerLib();let c;
 for(let t=0;t<6&&!c;t++){const k=''+(1000+R(9000));try{peer=await open(PFX+k);c=k}catch(e){if(e.type!=='unavailable-id')throw e}}
 if(!c)throw Error('id');
 room=c;host=1;me=0;conns=[null];G={phase:'lobby',room:c,tt:12,players:[{name:myName}]};
 peer.on('connection',k=>{k.on('data',d=>hd(k,d));k.on('close',()=>gone(k))});
 peer.on('disconnected',()=>setTimeout(()=>{try{peer.reconnect()}catch(e){}},1500));
 render()}
async function joinRoom(c){await peerLib();peer=await open();
 await new Promise((ok,ng)=>{const k=hc=peer.connect(PFX+c,{reliable:true,serialization:'json'}),to=setTimeout(()=>ng(Error('timeout')),12000);
  peer.on('error',e=>{clearTimeout(to);ng(e)});
  k.on('open',()=>{clearTimeout(to);k.send({m:'join',name:myName});ok()});
  k.on('data',gd);
  k.on('close',()=>{if(G){alert('ホストとの接続が切れました');location.reload()}})})}
function hd(c,d){
 if(d.m==='join'){if(conns.includes(c))return;
  if(G.phase!=='lobby'||G.players.length>=4){c.send({m:'rej',t:G.phase!=='lobby'?'ゲームはもう始まっています':'満員です（最大4人）'});setTimeout(()=>c.close(),600);return}
  const i=G.players.length;G.players.push({name:uniq(d.name)});conns[i]=c;c.send({m:'you',i});bc()}
 else if(d.m==='act'){const i=conns.indexOf(c);if(i>0)act(i,d)}}
function gone(c){const i=conns.indexOf(c);if(i<1)return;
 if(G.phase==='lobby'){G.players.splice(i,1);conns.splice(i,1);conns.forEach((k,j)=>k&&k.send({m:'you',i:j}))}
 else{G.players[i].off=1;if(pend&&pend.i===i){const q=pend;pend=null;q.res(auto(i,q.ty,q.x))}}
 bc()}
const gd=d=>{if(d.m==='you')me=d.i;else if(d.m==='S'){G=d.s;render()}else if(d.m==='rej'){$('#er').textContent=d.t;scr('t')}};
const send=a=>host?act(me,a):hc&&hc.open&&hc.send({m:'act',...a});

/* ============ 画面 ============ */
const scr=x=>document.querySelectorAll('.s').forEach(e=>e.classList.toggle('on',e.id==='s'+x));
function render(){if(!G)return;const f=G.phase;scr(f==='lobby'?'l':f==='play'?'g':'e');f==='lobby'?rl():f==='play'?rg():re()}
function rl(){$('#code').textContent=G.room;
 $('#ml').innerHTML=G.players.map((p,i)=>`<div class="r"><span class="bg" style="background:${COL[i]}">${i+1}</span>${esc(p.name)}${i===me?'（あなた）':''}${p.cpu?' 🤖':''}</div>`).join('');
 $('#len').innerHTML=[[5,'テスト 5ターン'],[12,'1年 12ターン'],[24,'2年 24ターン'],[36,'3年 36ターン']]
  .map(([n,t])=>`<button class="${G.tt===n?'p':''}" data-a="len" data-n="${n}" ${host?'':'disabled'}>${t}</button>`).join('');
 $('#hb').style.display=host?'':'none';$('#gw').style.display=host?'none':''}
function rg(){const P=G.players,m=G.cur===me,s=G.sub,can=m&&s==='start'&&!G.used;if(!can)pk=-1;
 $('#hd').innerHTML=`<span>${yr()}年目 ${(G.turn+2)%12+1}月</span><small>${G.turn}/${G.tt}ターン</small>`;
 $('#db').innerHTML=`🎯 目的地 <b>${ST[G.dest][0]}</b>　あと${D[P[me].node][G.dest]}マス`;
 $('#ps').innerHTML=P.map((q,i)=>`<div class="pc${i===G.cur?' cur':''}"><span class="bg" style="background:${COL[i]}">${i+1}</span>${esc(q.name)}${q.god?'👹':''}<br>${fm(q.cash)}<small>🏠${G.own.filter(o=>o===i).length} 🃏${q.cards.length}${q.off&&!q.cpu?' 切断':''}</small></div>`).join('');
 let h='';
 if(can&&pk>=0)h='<div class="w">だれに使う？</div>'+P.map((q,j)=>j===me?'':`<button data-a="tg" data-n="${j}">${esc(q.name)}</button>`).join('')+'<button data-a="no">やめる</button>';
 else if(can)h=`<button class="p big w" data-a="roll">🎲 サイコロを振る${G.dn>1?'（'+G.dn+'個）':''}</button>`;
 else if(m&&s==='dir')h='<div class="w">どっちへ進む？（マップをタップでもOK）</div>'+G.opts.map(n=>`<button class="big" data-a="dir" data-n="${n}">${ST[n][0]}へ</button>`).join('');
 else if(m&&s==='buy'){const x=ST[G.bn];h=`<div class="w">${x[5]}（${x[0]}）${fm(x[6])}<br><small>年${x[7]}％＝毎年${fm(Math.floor(x[6]*x[7]/100))}の収益</small></div><button class="g" data-a="buy" data-y="1">買う</button><button data-a="buy" data-y="0">買わない</button>`}
 $('#ac').innerHTML=h;
 $('#msg').textContent=can?'あなたのばんです！':G.msg;
 $('#hand').innerHTML=P[me].cards.map((c,k)=>`<button data-a="card" data-i="${k}" ${can?'':'disabled'}>${CD[c][1]} ${CD[c][0]}<small>${CD[c][2]}</small></button>`).join('');
 if(G.ev&&G.ev.id!==seen){seen=G.ev.id;const t=$('#toast');t.textContent=G.ev.t;t.classList.add('on');clearTimeout(t._h);t._h=setTimeout(()=>t.classList.remove('on'),1500)}}
function re(){$('#rk').innerHTML=G.rank.map((r,k)=>`<div class="pl"><div class="r"><b>${k+1}位</b><span class="bg" style="background:${COL[r.i]}">${r.i+1}</span>${k?'':'🏆 '}${esc(G.players[r.i].name)}</div><div style="font:900 26px sans-serif">${fm(r.t)}</div><small>所持金 ${fm(r.c)}＋物件 ${fm(r.v)}</small></div>`).join('');
 document.querySelector('[data-a=again]').style.display=host?'':'none'}

async function go(h){myName=[...($('#nm').value.trim()||'プレイヤー')].slice(0,6).join('');
 const c=$('#cd').value.trim(),er=$('#er');
 if(!h&&!/^\d{4}$/.test(c)){er.textContent='ルームIDは4けたの数字です';return}
 er.textContent='接続中…';
 try{await(h?mkRoom():joinRoom(c));er.textContent=''}
 catch(e){er.textContent=e.type==='peer-unavailable'?'そのルームIDは見つかりません':e.message==='timeout'?'つながりませんでした。Wi-Fiなど回線を変えてもう一度試してください':'通信エラー：'+(e.type||e.message)}}

document.addEventListener('click',e=>{const b=e.target.closest('[data-a]');if(!b||b.disabled)return;const a=b.dataset.a,d=b.dataset;
 if(a==='host'||a==='join')go(a==='host');
 else if(a==='len'&&host){G.tt=+d.n;bc()}
 else if(a==='cpu'&&host&&G.players.length<4){G.players.push({name:'CPU'+G.players.length,cpu:1});conns.push(null);bc()}
 else if(a==='start'&&host&&G.players.length>1)start();
 else if(a==='roll')send({a});
 else if(a==='dir')send({a,n:+d.n});
 else if(a==='buy')send({a,y:+d.y});
 else if(a==='card'){const c=G.players[me].cards[+d.i];if('bs'.includes(c)){pk=+d.i;render()}else send({a,ci:+d.i})}
 else if(a==='tg'){send({a:'card',ci:pk,tg:+d.n});pk=-1}
 else if(a==='no'){pk=-1;render()}
 else if(a==='again'&&host)again();
 else if(a==='quit')location.reload()});

// マップをタップして分岐を選ぶ
$('#cv').onclick=e=>{if(!G||G.cur!==me||G.sub!=='dir')return;
 const c=e.target,r=c.getBoundingClientRect(),[s,ox,oy]=c._t,X=(e.clientX-r.left-ox)/s,Y=(e.clientY-r.top-oy)/s,
  n=G.opts.find(k=>Math.hypot(ST[k][1]-X,ST[k][2]-Y)<32);if(n!=null)send({a:'dir',n})};

// マップ描画 (Canvas)
function draw(){requestAnimationFrame(draw);if(!G||G.phase!=='play')return;
 const c=$('#cv'),r=devicePixelRatio||1,w=c.clientWidth,h=c.clientHeight;if(!w)return;
 const W=Math.round(w*r),H=Math.round(h*r);if(c.width!==W||c.height!==H){c.width=W;c.height=H}
 const x=c.getContext('2d'),s=Math.min(w/360,h/510),ox=(w-360*s)/2,oy=(h-510*s)/2,t=Date.now()/300,gp=k=>k<15?0:k<17?1:k<20?2:3;
 c._t=[s,ox,oy];x.setTransform(r,0,0,r,0,0);x.fillStyle='#cfe6ee';x.fillRect(0,0,w,h);
 x.save();x.translate(ox,oy);x.scale(s,s);
 // 陸地
 x.lineJoin=x.lineCap='round';x.fillStyle=x.strokeStyle='#e3ecbd';x.lineWidth=40;x.setLineDash([]);
 x.beginPath();for(let k=0;k<15;k++)x[k?'lineTo':'moveTo'](ST[k][1],ST[k][2]);x.closePath();x.fill();x.stroke();
 const E=[];NX.forEach((o,a)=>o.forEach(b=>E.push([ST[a],ST[b],gp(a)!==gp(b)])));
 E.forEach(([A,B,z])=>{if(!z){x.beginPath();x.moveTo(A[1],A[2]);x.lineTo(B[1],B[2]);x.stroke()}});
 // 線路（白黒の鉄道記号）と進行方向の矢印、島をつなぐ航路は点線
 E.forEach(([A,B,z])=>{x.beginPath();x.moveTo(A[1],A[2]);x.lineTo(B[1],B[2]);
  if(z){x.strokeStyle='#fff';x.lineWidth=3;x.setLineDash([5,5]);x.stroke()}
  else{x.strokeStyle='#1b2a49';x.lineWidth=5;x.stroke();x.strokeStyle='#fff';x.lineWidth=2.5;x.setLineDash([6,6]);x.stroke()}
  x.setLineDash([]);
  x.save();x.translate((A[1]+B[1])/2,(A[2]+B[2])/2);x.rotate(Math.atan2(B[2]-A[2],B[1]-A[1]));
  x.fillStyle=z?'#fff':'#e2492f';x.beginPath();x.moveTo(7,0);x.lineTo(-4,-5);x.lineTo(-4,5);x.fill();x.restore()});
 // 駅
 x.textAlign='center';x.textBaseline='middle';
 ST.forEach((n,k)=>{const o=G.own[k],l=n[4];
  x.beginPath();x.arc(n[1],n[2],12,0,7);x.fillStyle=TY[n[3]][0];x.fill();
  x.lineWidth=3;x.strokeStyle=o>=0?COL[o]:'#fff';x.stroke();
  x.lineWidth=1.5;x.strokeStyle='#1b2a49';x.beginPath();x.arc(n[1],n[2],13.5,0,7);x.stroke();
  x.fillStyle=n[3]==='c'?'#1b2a49':'#fff';x.font='900 13px sans-serif';x.fillText(TY[n[3]][1],n[1],n[2]+1);
  const lx=n[1]+(l==='r'?18:l==='l'?-18:0),ly=n[2]+(l==='b'?22:l==='t'?-22:0);
  x.font='900 11px sans-serif';x.textAlign=l==='r'?'left':l==='l'?'right':'center';
  x.lineWidth=3;x.strokeStyle='#fff';x.strokeText(n[0],lx,ly);x.fillStyle='#1b2a49';x.fillText(n[0],lx,ly);x.textAlign='center'});
 // 目的地の旗
 const d=ST[G.dest];x.beginPath();x.arc(d[1],d[2],17+Math.sin(t)*2,0,7);x.strokeStyle='#f4b400';x.lineWidth=3;x.stroke();
 x.fillStyle='#1b2a49';x.fillRect(d[1]+10,d[2]-34,2,24);
 x.fillStyle='#e2492f';x.beginPath();x.moveTo(d[1]+12,d[2]-34);x.lineTo(d[1]+27,d[2]-28);x.lineTo(d[1]+12,d[2]-22);x.fill();
 // 分岐の選択肢
 if(G.sub==='dir')G.opts.forEach(k=>{x.beginPath();x.arc(ST[k][1],ST[k][2],19+Math.sin(t*2)*3,0,7);x.strokeStyle='#e2492f';x.lineWidth=4;x.stroke()});
 // コマ
 G.players.forEach((p,i)=>{const n=ST[p.node],g=G.players.map((q,j)=>q.node===p.node?j:-1).filter(j=>j>=0),
  px=n[1]+(g.indexOf(i)-(g.length-1)/2)*16,py=n[2]+(n[4]==='t'?24:-24);
  x.beginPath();x.arc(px,py,9,0,7);x.fillStyle=COL[i];x.fill();x.lineWidth=2.5;x.strokeStyle=i===G.cur?'#1b2a49':'#fff';x.stroke();
  x.fillStyle='#fff';x.font='900 11px sans-serif';x.fillText(i+1,px,py+1);
  if(p.god){x.font='15px sans-serif';x.fillText('👹',px,py-16)}});
 x.restore()}
requestAnimationFrame(draw);
</script>
